<%- include('partials/header') %>

<section class="hero">
  <span class="eyebrow">Multi-restaurant ordering</span>
  <h1>Welcome to Campus Eats</h1>
  <p>Order from multiple restaurants, all in one place.</p>
</section>

<section class="restaurants">
  <h2>Popular Restaurants</h2>

  <div class="restaurant-grid">
    <% restaurants.forEach(r => { %>

      <div class="restaurant-card">

        <div class="avatar">
          <%= r.name.charAt(0) %>
        </div>

        <h3><%= r.name %></h3>

        <p><%= r.cuisine %></p>

        <span class="rating-pill">
          ★ <%= r.rating %>
        </span>

        <a href="/restaurants/<%= r.id %>/menu" class="btn">
          View Menu
        </a>

      </div>

    <% }); %>
  </div>
</section>

<section class="stats-bar">

  <div>
    <strong><%= stats.total_orders %></strong>
    <span>Total Orders</span>
  </div>

  <div>
    <strong>Nu. <%= stats.total_revenue %></strong>
    <span>Total Revenue</span>
  </div>

</section>

<section class="popular">

  <h2>Popular Items</h2>

  <div class="popular-grid">

    <% if (popularItems && popularItems.length > 0) { %>

      <% popularItems.forEach(item => { %>

        <div class="popular-item">
          <h3><%= item.name %></h3>
          <p>
            Ordered <%= item.times_ordered %> times
          </p>
        </div>

      <% }); %>

    <% } else { %>

      <p>No orders yet.</p>

    <% } %>

  </div>

</section>

<%- include('partials/footer') %>